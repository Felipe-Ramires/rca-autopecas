@{
    ViewData["Title"] = "Pedidos";
}

@section PageHeader {
@if (User.IsInRole("Cliente"))
    {
        <h3 class="m-0">Meus Pedidos</h3>
    }else
    {
        <h3 class="m-0">Pedidos</h3>
    }
}
@section Styles{
    <link rel="stylesheet" href="~/css/order.css" asp-append-version="true" />
}
<table class="table table-hover">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">First</th>
            <th scope="col">Last</th>
            <th scope="col">Handle</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <th scope="row">1</th>
            <td>Mark</td>
            <td>Otto</td>
            <td>mdo</td>
        </tr>
        <tr>
            <th scope="row">2</th>
            <td>Jacob</td>
            <td>Thornton</td>
            <td>fat</td>
        </tr>
        <tr>
            <th scope="row">3</th>
            <td colspan="2">Larry the Bird</td>
            <td>twitter</td>
        </tr>
    </tbody>
</table>

@section Scripts{
    <script src="~/js/order.js"></script>
}